from datetime import date, datetime
from enum import Enum
from typing import Self

__all__ = [
    "COUNTRY_CODES",
    "COUNTRY_CODES3",
    "EXCHANGE_CODES",
    "Calendar",
    "date_range",
]

EXCHANGE_CODES: list[str]
COUNTRY_CODES: list[str]
COUNTRY_CODES3: list[str]

def date_range(start: date, end: date, *, step_days: int = 1) -> list[date]: ...

class Calendar:
    @classmethod
    def from_range(cls, start: date, end: date, *, step_days: int = 1) -> Self: ...
    @classmethod
    def from_exchange(cls, code: str | Enum) -> Self: ...
    @classmethod
    def from_product(cls, exchange: str | Enum, product: str | Enum) -> Self: ...
    @classmethod
    def from_asset(cls, exchange: str | Enum, asset_class: str | Enum, *, subclass: str | Enum | None = None) -> Self: ...
    @classmethod
    def from_region(cls, code: str | Enum) -> Self: ...
    @property
    def name(self) -> str: ...
    @property
    def source_kind(self) -> str: ...
    @property
    def source_calendar(self) -> str | None: ...
    @property
    def market_type(self) -> str: ...
    @property
    def weekmask(self) -> list[bool]: ...
    @property
    def regular_sessions(self) -> list[tuple[int, int, int, int, int, int]]: ...
    @property
    def extended_hours(self) -> list[tuple[str, int, int, int, int, int, int]]: ...
    @property
    def timezone(self) -> str: ...
    def is_business_day(self, d: date) -> bool: ...
    def is_holiday(self, d: date) -> bool: ...
    def next_business_day(self, d: date) -> date: ...
    def previous_business_day(self, d: date) -> date: ...
    def business_days_between(self, start: date, end: date) -> int: ...
    def days(self, start: date | None = None, end: date | None = None, *, step_days: int | None = None) -> list[date]: ...
    def business_days(self, start: date | None = None, end: date | None = None) -> list[date]: ...
    def holidays(self, start: int | date, end: date | None = None) -> list[date]: ...
    def sessions(self, start: date, end: date) -> list[tuple[datetime, datetime]]: ...
    def extended_sessions(self, start: date, end: date) -> list[tuple[str, datetime, datetime]]: ...
    def is_open(self, when: datetime) -> bool: ...
    def next_open(self, when: datetime) -> datetime | None: ...
    def next_close(self, when: datetime) -> datetime | None: ...
    def early_close_for(self, date: date) -> tuple[int, int] | None: ...
